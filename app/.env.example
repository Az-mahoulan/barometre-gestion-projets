# Copier en .env et remplacer chaque valeur. Ne jamais versionner .env.

# --- Django ---
DJANGO_DEBUG=0
# Générer : python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=pilotage.exemple.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://pilotage.exemple.org
# Mettre 0 uniquement si le TLS est terminé en amont et que le proxy transmet X-Forwarded-Proto
DJANGO_SECURE_SSL_REDIRECT=1

# --- Base de données (PostgreSQL) ---
POSTGRES_DB=barometre
POSTGRES_USER=barometre
POSTGRES_PASSWORD=
DATABASE_URL=postgres://barometre:MOT_DE_PASSE@db:5432/barometre

# --- Démonstration uniquement (laisser vide en production) ---
APP_DEMO_TODAY=
DEMO_PASSWORD=
